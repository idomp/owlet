{
  "config": {
    "step": {
      "user": {
        "description": "Log in with the account you use in the Owlet app.",
        "data": {
          "region": "Region",
          "username": "Email",
          "password": "[%key:common::config_flow::data::password%]"
        },
        "data_description": {
          "region": "Pick Europe if your Owlet account was created in the EU or UK, otherwise pick World."
        }
      },
      "reauth_confirm": {
        "title": "Reauthentication required for Owlet",
        "description": "The Owlet login for {username} is no longer valid. Enter the password again.",
        "data": {
          "password": "[%key:common::config_flow::data::password%]"
        }
      },
      "reconfigure": {
        "title": "Reconfigure Owlet",
        "description": "Change the region or log in again for {username}.",
        "data": {
          "region": "Region",
          "password": "[%key:common::config_flow::data::password%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_email": "Entered email address is incorrect",
      "invalid_password": "Entered password is incorrect",
      "invalid_credentials": "Entered credentials are incorrect",
      "no_devices": "No supported Owlet sock found on this account",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Configure options for Owlet",
        "data": {
          "scan_interval": "Polling interval (seconds)",
          "stale_threshold": "Stale data threshold (minutes)"
        },
        "data_description": {
          "scan_interval": "Seconds between requests to the Owlet cloud, minimum 5. Every poll costs several API calls per sock, a lower value increases the risk of rate limiting.",
          "stale_threshold": "When the Owlet cloud has no new reading for this many minutes, vitals become unavailable and the Data stale sensor turns on. Set to 0 to disable."
        }
      }
    }
  },
  "selector": {
    "region": {
      "options": {
        "europe": "Europe",
        "world": "World"
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "charging": {
        "name": "Charging"
      },
      "high_hr_alrt": {
        "name": "High heart rate alert"
      },
      "low_hr_alrt": {
        "name": "Low heart rate alert"
      },
      "high_ox_alrt": {
        "name": "High oxygen alert"
      },
      "low_ox_alrt": {
        "name": "Low oxygen alert"
      },
      "crit_ox_alrt": {
        "name": "Critical oxygen alert"
      },
      "low_batt_alrt": {
        "name": "Low battery alert"
      },
      "crit_batt_alrt": {
        "name": "Critical battery alert"
      },
      "lost_pwr_alrt": {
        "name": "Lost power alert"
      },
      "sock_discon_alrt": {
        "name": "Sock disconnected alert"
      },
      "sock_off": {
        "name": "Sock off"
      },
      "awake": {
        "name": "Awake"
      },
      "data_stale": {
        "name": "Data stale"
      },
      "base_station_on": {
        "name": "Base station on"
      }
    },
    "sensor": {
      "batterypercent": {
        "name": "Battery percentage"
      },
      "signalstrength": {
        "name": "Signal strength"
      },
      "o2saturation": {
        "name": "O2 saturation"
      },
      "o2saturation10a": {
        "name": "O2 saturation 10 minute average"
      },
      "heartrate": {
        "name": "Heart rate"
      },
      "batterymin": {
        "name": "Battery remaining"
      },
      "skintemp": {
        "name": "Skin temperature"
      },
      "sleepstate": {
        "name": "Sleep state",
        "state": {
          "unknown": "Unknown",
          "awake": "Awake",
          "light_sleep": "Light sleep",
          "deep_sleep": "Deep sleep"
        }
      },
      "movement": {
        "name": "Movement"
      },
      "movementbucket": {
        "name": "Movement bucket"
      },
      "last_updated": {
        "name": "Last reading"
      }
    }
  },
  "issues": {
    "stale_data": {
      "title": "Owlet data has not been updated for a long time",
      "description": "{name} has not sent a new reading to the Owlet cloud since {last_reading}, while the sock is not charging and the base station is on.\n\nCheck that the base station has power and Wi-Fi, and that the Owlet app shows live data. This message disappears by itself once new readings arrive."
    }
  }
}
